# Local Docker (`docker compose up` in the repo root). Copy this file to
# `.env.local` — Next.js loads that automatically. Do not commit `.env.local`.
DATABASE_URL=postgres://openciclo:openciclo@localhost:5432/openciclo
SESSION_SECRET=local-dev-session-secret-change-me
SESSION_COOKIE_SECURE=false
EMAIL_LOOKUP_SECRET=local-dev-email-hmac-secret-change-me
APP_URL=http://localhost:3000
# Comma-separated operator emails for /console. HMAC-compared to recovery mailboxes.
# Leave empty so /console 404s. Phrase-only accounts cannot match.
CONSOLE_EMAILS=
# Production email signup: Resend. Local: Mailpit via SMTP_HOST (docker compose).
# Without Resend or SMTP, creating an email account returns 503.
MAIL_FROM=Ciclo <noreply@localhost>
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
